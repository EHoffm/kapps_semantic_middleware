@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cfc: <https://w3id.org/circularfactory/Core#> .
@prefix svc: <https://w3id.org/circularfactory/Service#> .
@prefix ex:  <https://example.org/kapps-demo#> .

#################################################################
# Self-contained ground-truth ontology for Scenario 2 (decentralized door) ONLY.
#
# A transformer-cell door controlled by a small PLC: two invokable workflows
# (open, close) and one readable, high-frequency StateProperty (status). Declares
# exactly the classes scenario 2 needs — nothing else — so seeding inserts only
# the door vocabulary (no unrelated hello-world classes). Same direct-subClassOf
# discipline as scenario 1 (ADR 0003).
#################################################################

# --- Minimal Core class stubs referenced by the demo (kept local for self-containment) ---
cfc:Resource rdf:type owl:Class .
cfc:Capability rdf:type owl:Class .
cfc:EquippedCapability rdf:type owl:Class ; rdfs:subClassOf cfc:Capability .
cfc:Task rdf:type owl:Class .
cfc:Operation rdf:type owl:Class ; rdfs:subClassOf cfc:Task .

ex:DoorResource rdf:type owl:Class ;
    rdfs:subClassOf cfc:Resource ;
    rdfs:label "Door Resource" ;
    rdfs:comment "A decentrally-controlled transformer-cell door." .

ex:DoorControllerService rdf:type owl:Class ;
    rdfs:subClassOf svc:Service ;
    rdfs:label "Door Controller Service" .

ex:DoorOpenCapability rdf:type owl:Class ;
    rdfs:subClassOf cfc:EquippedCapability , cfc:Capability ;
    rdfs:label "Door Open Capability" .

ex:DoorCloseCapability rdf:type owl:Class ;
    rdfs:subClassOf cfc:EquippedCapability , cfc:Capability ;
    rdfs:label "Door Close Capability" .

ex:DoorStatusCapability rdf:type owl:Class ;
    rdfs:subClassOf cfc:EquippedCapability , cfc:Capability ;
    rdfs:label "Door Status Capability" ;
    rdfs:comment "The readable capability provided by the door's status StateProperty." .

ex:DoorOpenWorkflow rdf:type owl:Class ;
    rdfs:subClassOf svc:Workflow ;
    rdfs:label "Door Open Workflow" .

ex:DoorCloseWorkflow rdf:type owl:Class ;
    rdfs:subClassOf svc:Workflow ;
    rdfs:label "Door Close Workflow" .

ex:DoorStatusStateProperty rdf:type owl:Class ;
    rdfs:subClassOf svc:StateProperty ;
    rdfs:label "Door Status State Property" ;
    rdfs:comment "The GET-readable status (opened/closed) of the door; its live value is never persisted to the graph." .
