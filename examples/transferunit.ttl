@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cfc:  <https://w3id.org/circularfactory/Core#> .
@prefix svc:  <https://w3id.org/circularfactory/Service#> .
@prefix tu:   <https://www.sfb1574.kit.edu/ontologies/TransferUnit#> .
@prefix tui:  <https://www.sfb1574.kit.edu/ontologies/TransferUnitInstances#> .

#################################################################
# Self-contained ground-truth ontology for Scenario 3 (TransferUnit) ONLY.
#
# The scenario3 integration test (map #24 / #25): a mock-PLC -> middleware ->
# controller loop over a TransferUnit that has two conveyor belts and two light
# barriers. The conveyor speed is a *settable* control variable (read AND set at
# one endpoint); the light barriers are read-only occupancy sensors.
#
# Extends the sfb1574 minimal `tu:` TransferUnit ontology (kapps_ogm's shared
# example, kept as the `tu:` namespace) and re-homes it onto the middleware
# stack: cfc: Core (Resource/Capability/Operation) + svc: (Service/StateProperty).
# Declares exactly the classes scenario3 needs — nothing else — so seeding a
# clean repo inserts only the TransferUnit vocabulary. Same direct-subClassOf
# discipline as scenarios 1 and 2 (ADR 0003): every domain class declares a
# DIRECT rdfs:subClassOf to the exact base the middleware asserts against, so the
# ground-truth check (a direct rdfs:subClassOf existence query) passes without a
# reasoner. Co-load with ontology/service.ttl (the svc: module), exactly as
# seed.py does for scenarios 1 and 2.
#
# NOTE: no SHACL shapes here. Per ADR 0013 and #25's locked scope, the write-
# payload shape for the settable conveyor speed (e.g. speed in [0, maxSpeed]) is
# deferred with the rest of SHACL Interop. Scenario3 is states-only (a settable
# StateProperty + readable StateProperties); it exposes NO svc:Workflow — setting
# a setpoint is modelled as a settable state, not a workflow (ADR 0013, "Not a
# Workflow").
#################################################################
# CHANGELOG (root ADR 0001 — detailed changelog comment blocks)
#
# 2026-07-23  #25  DRAFT — initial authoring (awaiting Etienne review).
#   - Ported the sfb1574 `tu:` TransferUnit topology (TransferUnit composed of
#     ConveyorBelt + LightBarrier sub-resources; tu:hasConveyorBelt /
#     tu:hasLightBarrier) onto cfc:/svc: as the scenario3 ground-truth ontology.
#   - Added tu:TransferUnitService (svc:Service), tu:ConveyorSpeedProperty
#     (svc:SettableStateProperty, per ADR 0013 / #26), tu:LightBarrierProperty
#     (svc:StateProperty, read-only), and their capabilities
#     tu:ConveyorSpeedCapability / tu:LightBarrierCapability.
#   - Added instance data: tui:TransferUnit1 with two conveyor belts
#     (left/right) and two light barriers (front/back).
#   - DROPPED from the sfb1574 example: the inf: (CrcInterfaces) import and all
#     inf:hasValue / tu:hasUnit parameter blank nodes (a StateProperty's live
#     value is never persisted to the graph — it is served over the GET/PUT
#     endpoint; svc: comment). Also dropped tu:hasConveyorPosition and
#     tu:isWorking (out of scenario3 scope: settable speed + readable barriers).
#   - DEPENDENCY: references svc:SettableStateProperty, which does NOT yet exist
#     in ontology/service.ttl. It is added by issue #36 (ready-for-agent). Until
#     #36 lands, tu:ConveyorSpeedProperty's parent class is undefined and
#     registration cannot infer settability — this file does not fully validate.
#################################################################

#################################################################
# Minimal Core class stubs referenced by the scenario (kept local for
# self-containment, matching scenarios 1 and 2).
#################################################################
cfc:Resource rdf:type owl:Class .
cfc:Capability rdf:type owl:Class .
cfc:EquippedCapability rdf:type owl:Class ; rdfs:subClassOf cfc:Capability .
cfc:Task rdf:type owl:Class .
cfc:Operation rdf:type owl:Class ; rdfs:subClassOf cfc:Task .

# The Operation->Capability link is declared so create_operation persists an Operation
# through the OGM's validated write path (ADR 0008) rather than raw triples.
cfc:implementsCapability rdf:type owl:ObjectProperty ;
    rdfs:domain cfc:Operation ;
    rdfs:range cfc:Capability ;
    rdfs:label "implements capability" .

#################################################################
# Resource types (topology carried over from the sfb1574 `tu:` example)
#
# A TransferUnit is composed of ConveyorBelt and LightBarrier sub-resources, each
# a cfc:Resource in its own right — mirroring the sfb1574 minimal ontology
# (tu:hasConveyorBelt / tu:hasLightBarrier). One tu:TransferUnitService (below)
# wraps the whole TransferUnit and exposes the state of its components.
#################################################################

tu:TransferUnit rdf:type owl:Class ;
    rdfs:subClassOf cfc:Resource ;
    rdfs:label "Transfer Unit" ;
    rdfs:comment "A material-transport resource composed of conveyor belts and light barriers; moves a workpiece across a transfer point under decentralized PLC control." .

tu:ConveyorBelt rdf:type owl:Class ;
    rdfs:subClassOf cfc:Resource ;
    rdfs:label "Conveyor Belt" ;
    rdfs:comment "A driven belt of a TransferUnit. Its conveyor speed is a settable control variable, exposed as a tu:ConveyorSpeedProperty at runtime." .

tu:LightBarrier rdf:type owl:Class ;
    rdfs:subClassOf cfc:Resource ;
    rdfs:label "Light Barrier" ;
    rdfs:comment "A photoelectric occupancy sensor of a TransferUnit. Its blocked/clear state is read-only, exposed as a tu:LightBarrierProperty at runtime." .

#################################################################
# Composition object properties (carried over from the sfb1574 `tu:` example)
#################################################################

tu:hasConveyorBelt rdf:type owl:ObjectProperty ;
    rdfs:label "hasConveyorBelt" ;
    rdfs:comment "Relates a TransferUnit to a ConveyorBelt component it is composed of." ;
    rdfs:domain tu:TransferUnit ;
    rdfs:range tu:ConveyorBelt .

tu:hasLightBarrier rdf:type owl:ObjectProperty ;
    rdfs:label "hasLightBarrier" ;
    rdfs:comment "Relates a TransferUnit to a LightBarrier component it is composed of." ;
    rdfs:domain tu:TransferUnit ;
    rdfs:range tu:LightBarrier .

#################################################################
# Service type (one Service wraps the whole TransferUnit)
#################################################################

tu:TransferUnitService rdf:type owl:Class ;
    rdfs:subClassOf svc:Service ;
    rdfs:label "Transfer Unit Service" ;
    rdfs:comment "The middleware Service wrapping a TransferUnit. Exposes each belt's settable conveyor-speed StateProperty and each barrier's readable occupancy StateProperty through the knowledge graph." .

#################################################################
# Capability types
#
# One Capability class per exposed StateProperty kind, following scenario 2's
# pattern (ex:DoorStatusCapability). The instance-level svc:providesCapability /
# svc:providedByStateProperty links are minted at runtime by @mw.state (ADR
# 0003), not authored here.
#################################################################

tu:ConveyorSpeedCapability rdf:type owl:Class ; #TODO: We do not need capabilities for speed and lightbarriers. this is wrong modeling, delete
    rdfs:subClassOf cfc:EquippedCapability ,
                    cfc:Capability ;
    rdfs:label "Conveyor Speed Capability" ;
    rdfs:comment "The settable-and-readable capability provided by a belt's tu:ConveyorSpeedProperty: read the current conveyor speed and set a new setpoint at the same endpoint." .

tu:LightBarrierCapability rdf:type owl:Class ; #TODO: We do not need capabilities for speed and lightbarriers. this is wrong modeling, delete
    rdfs:subClassOf cfc:EquippedCapability ,
                    cfc:Capability ;
    rdfs:label "Light Barrier Capability" ;
    rdfs:comment "The readable capability provided by a barrier's tu:LightBarrierProperty: read whether the barrier is currently occupied (blocked) or clear." .

#################################################################
# StateProperty types
#
# tu:ConveyorSpeedProperty is SETTABLE — svc:SettableStateProperty (a subclass of
# svc:StateProperty; ADR 0013 / #26): read (GET) and set (PUT/POST) one control
# variable at one svc:endpoint. tu:LightBarrierProperty is a plain read-only
# svc:StateProperty. Neither's live value is ever persisted to the graph; only
# the stable endpoint triple is written at registration.
#
# DEPENDENCY: svc:SettableStateProperty is added to ontology/service.ttl by
# issue #36 (not yet landed). Referenced here per ADR 0013 and #25.
#################################################################

tu:ConveyorSpeedProperty rdf:type owl:Class ;
    rdfs:subClassOf svc:SettableStateProperty ;
    rdfs:label "Conveyor Speed State Property" ;
    rdfs:comment "The read-write conveyor speed of a ConveyorBelt: read the current speed over the GET endpoint and set a new setpoint at the same endpoint (svc:SettableStateProperty, ADR 0013). Its live value is never persisted to the graph." .

tu:LightBarrierProperty rdf:type owl:Class ;
    rdfs:subClassOf svc:StateProperty ;
    rdfs:label "Light Barrier State Property" ;
    rdfs:comment "The GET-readable occupancy (occupied/clear) of a LightBarrier; read-only (a plain svc:StateProperty). Its live value is never persisted to the graph." .

#################################################################
# Instance data — TransferUnit1 (two conveyor belts + two light barriers)
#
# The resource individuals only (topology mirrored from the sfb1574 tui:
# example, minus the persisted parameter values). The Service, StateProperty and
# Capability individuals — and their svc: wiring and endpoints — are minted at
# runtime by the middleware's registration (@mw.state), not authored here, per
# ADR 0003 and the scenario 1/2 convention.
#################################################################

tui:TransferUnit1 rdf:type owl:NamedIndividual ,
        tu:TransferUnit ;
    tu:hasConveyorBelt tui:ConveyorBelt1_left ,
        tui:ConveyorBelt1_right ;
    tu:hasLightBarrier tui:LightBarrier1_front ,
        tui:LightBarrier1_back ;
    rdfs:comment "Example transfer unit with two conveyor belts and two light barriers (scenario3 integration test)." .

tui:ConveyorBelt1_left rdf:type owl:NamedIndividual ,
        tu:ConveyorBelt ;
    rdfs:comment "Left conveyor belt of TransferUnit1; exposes one settable tu:ConveyorSpeedProperty at runtime." .

tui:ConveyorBelt1_right rdf:type owl:NamedIndividual ,
        tu:ConveyorBelt ;
    rdfs:comment "Right conveyor belt of TransferUnit1; exposes one settable tu:ConveyorSpeedProperty at runtime." .

tui:LightBarrier1_front rdf:type owl:NamedIndividual ,
        tu:LightBarrier ;
    rdfs:comment "Front light barrier of TransferUnit1; exposes one read-only tu:LightBarrierProperty at runtime." .

tui:LightBarrier1_back rdf:type owl:NamedIndividual ,
        tu:LightBarrier ;
    rdfs:comment "Back light barrier of TransferUnit1; exposes one read-only tu:LightBarrierProperty at runtime." .
