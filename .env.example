# GraphDB connection for examples and demo.
# GraphDB runs with security disabled in the local Docker image, so username/password
# are placeholders that GraphDBCredentials.from_env() merely requires.
# WARNING: The demo WIPES and re-seeds GRAPHDB_REPOSITORY on every run.
# Never point these variables at a shared GraphDB instance.
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=kapps-demo
GRAPHDB_USERNAME=admin
GRAPHDB_PASSWORD=root
